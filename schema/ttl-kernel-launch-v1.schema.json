{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ttl:schema:kernel-launch:1",
  "title": "TTL private kernel launch description version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "artifact", "kernel"],
  "properties": {
    "schema_version": {"const": 1},
    "backend": {"enum": ["libtorch_cuda", "libtorch_mps"]},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "file"],
      "properties": {
        "format": {"enum": ["cubin", "metallib"]},
        "file": {"type": "string", "pattern": "^[^/\\\\]+$"}
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "grid", "block", "shared_bytes"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "grid": {"$ref": "#/$defs/geometry"},
        "block": {"$ref": "#/$defs/geometry"},
        "shared_bytes": {
          "type": "integer", "minimum": 0, "maximum": 4294967295
        }
      }
    }
  },
  "$defs": {
    "geometry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 1, "maximum": 4294967295}
    }
  }
}
