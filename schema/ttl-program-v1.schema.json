{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ttl:schema:program:1",
  "title": "TTL pure kernel program version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "inputs", "outputs", "calls"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/tensor"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tensor"}
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
    },
    "dtype": {
      "enum": [
        "bool", "int8", "int32", "float16", "float32",
        "float4_e2m1", "float8_e4m3", "float8_e8m0"
      ]
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "dtype": {"$ref": "#/$defs/dtype"},
        "shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "arguments", "results"],
      "properties": {
        "function": {"$ref": "#/$defs/identifier"},
        "arguments": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
